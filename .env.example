DATABASE_URL="file:./dev.db"
# Use a long, random value. Required in production.
JWT_SECRET="replace-with-a-long-random-secret"
# Optional separate key used to hash OTP codes; otherwise JWT_SECRET is used.
OTP_SECRET="replace-with-a-different-long-random-secret"
# Required for admin account creation. Keep this secret and secure.
ADMIN_SECRET_KEY="replace-with-a-secure-admin-secret-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Twilio SMS credentials. These are required for real phone OTP delivery.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-your-twilio-auth-token"
TWILIO_FROM_NUMBER="+15005550006"

# Payment gateway credentials (Stripe example)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
# For Razorpay, use:
# RAZORPAY_KEY_ID="rzp_test_your_key_id"
# RAZORPAY_KEY_SECRET="your_secret_key"
