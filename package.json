{
  "name": "quickcourt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "dev:clean": "node -e \"console.log('\\n========================================\\n  QuickCourt Development Server\\n========================================\\n\\n  Portal Access Links:\\n\\n  [ADMIN]   http://localhost:3000/admin/login\\n  [OWNER]   http://localhost:3000/owner/login\\n  [PLAYER]  http://localhost:3000/player/login\\n\\n========================================\\n  Starting server...\\n========================================\\n');\" && next dev",
    "dev:player": "node scripts/open-portal.js /player/signup",
    "dev:player:login": "node scripts/open-portal.js /player/login",
    "dev:owner": "node scripts/open-portal.js /owner/signup",
    "dev:owner:login": "node scripts/open-portal.js /owner/login",
    "dev:admin": "node scripts/open-portal.js /admin/signup",
    "dev:admin:login": "node scripts/open-portal.js /admin/login",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js --confirm-destructive",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.116.0",
    "@swc/helpers": "^0.5.23",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "next": "^14.2.18",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  }
}
