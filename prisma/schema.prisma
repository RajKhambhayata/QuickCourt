generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           String          @default("USER")
  avatar         String?
  phone          String?
  status         String          @default("ACTIVE")
  isVerified     Boolean         @default(true)
  otpCode        String?
  otpExpiresAt   DateTime?
  otpAttempts    Int             @default(0)
  otpLastSentAt  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  auditLogs      AuditLog[]
  bookings       Booking[]
  coinLedgers    CoinLedger[]
  coupons        Coupon[]
  facilities     Facility[]
  gameSessions   GameSession[]
  lapRecords     LapRecord[]
  reports        Report[]
  reviews        Review[]
  standings      Standing[]
  streakProgress StreakProgress?
  waitlists      Waitlist[]
  wallet         Wallet?

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Facility {
  id              String   @id @default(cuid())
  name            String
  description     String
  address         String
  city            String
  state           String?  @default("Karnataka")
  pincode         String?
  images          String
  sports          String
  amenities       String
  venueType       String   @default("Indoor & Outdoor")
  status          String   @default("APPROVED")
  rejectionReason String?
  ownerId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  courts          Court[]
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reviews         Review[]

  @@index([ownerId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
}

model Court {
  id                 String        @id @default(cuid())
  facilityId         String
  name               String
  sportType          String
  surfaceType        String?       @default("Synthetic")
  pricePerHour       Float
  operatingStartHour Int           @default(6)
  operatingEndHour   Int           @default(23)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  blockedSlots       BlockedSlot[]
  bookings           Booking[]
  facility           Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  kartHeats          KartHeat[]
  waitlists          Waitlist[]

  @@index([facilityId])
  @@index([isActive])
  @@index([sportType])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  courtId   String
  date      String
  startTime String
  endTime   String
  reason    String   @default("Maintenance")
  createdAt DateTime @default(now())
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId])
  @@index([date])
}

model Booking {
  id                 String        @id @default(cuid())
  bookingNumber      String        @unique
  userId             String
  courtId            String
  date               String
  startTime          String
  endTime            String
  totalAmount        Float
  status             String        @default("PENDING_PAYMENT")
  paymentMethod      String        @default("UPI")
  paymentStatus      String        @default("PENDING")
  paymentProviderId  String?
  cancellationReason String?
  gameTokenUsed      Boolean       @default(false)
  appliedCouponId    String?
  couponDiscount     Float?        @default(0)
  coinsRedeemed      Int?          @default(0)
  coinsDiscount      Float?        @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  court              Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameSessions       GameSession[]

  @@index([userId])
  @@index([courtId])
  @@index([date])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(cuid())
  facilityId String
  userId     String
  rating     Int      @default(5)
  comment    String
  createdAt  DateTime @default(now())
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([userId])
  @@index([createdAt])
}

model Report {
  id           String   @id @default(cuid())
  reportedById String
  targetType   String
  targetId     String
  targetName   String
  reason       String
  status       String   @default("PENDING")
  adminNote    String?
  createdAt    DateTime @default(now())
  reportedBy   User     @relation(fields: [reportedById], references: [id], onDelete: Cascade)
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  coins     Int      @default(0)
  credit    Float    @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CoinLedger {
  id          String    @id @default(cuid())
  userId      String
  type        String
  amount      Int
  bookingId   String?
  description String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model StreakProgress {
  id           String   @id @default(cuid())
  userId       String   @unique
  windowStart  DateTime @default(now())
  count        Int      @default(0)
  rewardIssued Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String         @id @default(cuid())
  code            String         @unique
  title           String
  description     String?
  type            String
  value           Float
  ownerType       String         @default("SYSTEM")
  partnerId       String?
  userId          String?
  minBookingValue Float?         @default(0)
  maxDiscount     Float?
  expiresAt       DateTime
  status          String         @default("ACTIVE")
  usedAt          DateTime?
  gameSessionId   String?
  createdAt       DateTime       @default(now())
  partnerOutlet   PartnerOutlet? @relation(fields: [partnerId], references: [id])
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptions     Redemption[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model GameSession {
  id         String    @id @default(cuid())
  userId     String
  bookingId  String?
  gameType   String    @default("SMASH_RALLY")
  score      Int       @default(0)
  tier       String?
  tapLog     String?
  isVerified Boolean   @default(false)
  couponId   String?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isVerified])
  @@index([startedAt])
}

model PartnerOutlet {
  id          String       @id @default(cuid())
  name        String
  category    String       @default("Food Court")
  address     String
  city        String
  phone       String?
  image       String?
  menuItems   String
  offerRules  String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  coupons     Coupon[]
  redemptions Redemption[]
}

model Redemption {
  id         String        @id @default(cuid())
  couponId   String
  outletId   String
  staffId    String?
  staffName  String?
  redeemedAt DateTime      @default(now())
  coupon     Coupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  outlet     PartnerOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
}

model Season {
  id         String     @id @default(cuid())
  name       String
  sport      String     @default("KARTING")
  startDate  DateTime
  endDate    DateTime?
  rounds     String
  pointsRule String     @default("F1")
  status     String     @default("ACTIVE")
  createdAt  DateTime   @default(now())
  standings  Standing[]
}

model Standing {
  id          String   @id @default(cuid())
  seasonId    String
  playerId    String?
  teamName    String?
  points      Int      @default(0)
  podiums     Int      @default(0)
  fastestLaps Int      @default(0)
  rank        Int      @default(0)
  updatedAt   DateTime @updatedAt
  player      User?    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model KartHeat {
  id           String      @id @default(cuid())
  courtId      String?
  trackName    String
  date         String
  startTime    String
  endTime      String
  capacity     Int         @default(10)
  seatsTaken   Int         @default(0)
  kartClass    String      @default("ADULT")
  pricePerSeat Float       @default(650)
  status       String      @default("OPEN")
  createdAt    DateTime    @default(now())
  court        Court?      @relation(fields: [courtId], references: [id])
  lapRecords   LapRecord[]

  @@index([date])
  @@index([status])
}

model LapRecord {
  id        String   @id @default(cuid())
  heatId    String
  userId    String
  lapNo     Int
  timeMs    Int
  isBest    Boolean  @default(false)
  createdAt DateTime @default(now())
  heat      KartHeat @relation(fields: [heatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Waitlist {
  id         String    @id @default(cuid())
  courtId    String
  date       String
  startTime  String
  endTime    String
  userId     String
  status     String    @default("WAITING")
  notifiedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  court      Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
